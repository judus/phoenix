{
  "compilerOptions": {
    "composite": true,
    "jsx": "react-jsx",
    "lib": ["DOM", "DOM.Iterable", "ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "paths": {
      "@phoenix/contracts": ["../../packages/contracts/src/index.ts"]
    },
    "strict": true,
    "target": "ES2023",
    "types": ["vite/client"]
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "vite.config.ts"],
  "references": [
    { "path": "../../packages/control-deck-ui" },
    { "path": "../../packages/contracts" }
  ]
}
