<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false"><shape><solid android:color="#24252b" /><stroke android:width="1dp" android:color="#4b4f59" /></shape></item>
    <item android:state_selected="true"><shape><solid android:color="@color/action" /></shape></item>
    <item android:state_pressed="true"><shape><solid android:color="#4d3110" /><stroke android:width="1dp" android:color="@color/action" /></shape></item>
    <item><shape><solid android:color="@color/canvas" /><stroke android:width="1dp" android:color="@color/action" /></shape></item>
</selector>
