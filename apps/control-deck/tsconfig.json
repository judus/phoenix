{
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist",
    "paths": {
      "@jdu/control-deck-adapter-keyboard": ["../../packages/control-deck-adapter-keyboard/src/index.ts"],
      "@jdu/control-deck-core": ["../../packages/control-deck-core/src/index.ts"],
