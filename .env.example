# PHOENIX serves plain HTTP on loopback only. Put a trusted HTTPS reverse proxy in
# front of this address for tablets and other network devices.
PHOENIX_HOST=127.0.0.1
PHOENIX_PORT=3400
# Development uses repository-local data by default. Packaged releases use platform user directories.
# PHOENIX_PATH_MODE=installed
# PHOENIX_CONFIG_PATH=/absolute/config/directory
# PHOENIX_DATA_PATH=/absolute/data/directory
# PHOENIX_CACHE_PATH=/absolute/cache/directory
# PHOENIX_LOGS_PATH=/absolute/log/directory
# PHOENIX_DATABASE_PATH=/absolute/path/to/phoenix.sqlite
# PHOENIX_WEB_ROOT=/absolute/path/to/web/assets
# Optional developer override: auto, recording, or linux-xdotool
PHOENIX_INPUT_BACKEND=auto
# PHOENIX_SETTINGS_PATH=/absolute/path/to/settings.json
# PHOENIX_RUNTIME_SYSTEM_PATH=/absolute/path/to/system.json
# PHOENIX_ELITE_BINDINGS_DIRECTORY=/absolute/path/to/Elite Dangerous/Options/Bindings
# Catalogue data is fetched into the writable runtime directory on first launch.
# PHOENIX_CATALOGUE_REFRESH=false
# PHOENIX_CATALOGUE_REFRESH_HOURS=24

# Copilot is disabled when neither key is available.
# Prefer the app-specific variable below. If it is absent, PHOENIX inherits an existing
# OPENAI_API_KEY from the server process, which may come from the user's global environment.
# PHOENIX_OPENAI_API_KEY=
PHOENIX_OPENAI_MODEL=gpt-5.6-terra
PHOENIX_OPENAI_TIMEOUT_MS=180000
PHOENIX_OPENAI_MAX_RETRIES=1
PHOENIX_OPENAI_WIRE_LOG_ENABLED=false
# PHOENIX_OPENAI_WIRE_LOG_MAX_BYTES=26214400
# PHOENIX_OPENAI_WIRE_LOG_MAX_FILES=3
PHOENIX_OPENAI_REALTIME_MODEL=gpt-realtime-2.1-mini
PHOENIX_OPENAI_REALTIME_VOICE=marin
