PHOENIX_HOST=0.0.0.0
PHOENIX_PORT=3400
PHOENIX_DATABASE_PATH=data/runtime/phoenix.sqlite
PHOENIX_WEB_ROOT=apps/web/dist
# Optional developer override: auto, recording, or linux-xdotool
PHOENIX_INPUT_BACKEND=auto
# PHOENIX_SETTINGS_PATH=data/settings.json
# PHOENIX_RUNTIME_SYSTEM_PATH=data/runtime/system.json
# PHOENIX_ELITE_BINDINGS_DIRECTORY=/absolute/path/to/Elite Dangerous/Options/Bindings

# Copilot (disabled when neither key is set; OPENAI_API_KEY is also supported)
# PHOENIX_OPENAI_API_KEY=
PHOENIX_OPENAI_MODEL=gpt-5.6-terra
PHOENIX_OPENAI_TIMEOUT_MS=180000
PHOENIX_OPENAI_MAX_RETRIES=1
PHOENIX_OPENAI_WIRE_LOG_ENABLED=true
